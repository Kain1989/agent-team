# Agent Team MVP — local config. Copy to .env (setup.sh does this for you).
# The portal binds to 127.0.0.1 ONLY — it never listens on a public interface.

# Port for the Mission Control portal.
PORT=8770

# Path to the `claude` CLI. The job worker spawns headless `claude -p` to run code
# tasks under the locked-down gate. setup.sh autodetects it; override here if needed.
STANDUP_CLAUDE_BIN=

# Run the job-queue worker (the headline submit -> worktree -> approve -> commit loop).
# Keep this 1 — without it, submitted jobs sit queued and never run.
STANDUP_JOBWORKER=1

# Start the in-process scheduler LOOP (so /daily-standup can turn recurring runs on
# with no restart). Keep this 1. NOTE: this only RUNS the loop — it does NOT fire on
# its own. Firing stays OFF until you run /daily-standup (control/schedule.json,
# default off); /stop-daily-standup turns it back off. So default posture = on-demand.
STANDUP_SCHEDULER=1

{
  "_comment": "Bridge (2): governance for Claude Code NATIVE agent teams. These wrap our content guardrails + the kill switch onto the native team task lifecycle, so any native team running with this plugin enabled is governed the same way the job queue is. TaskCreated/TaskCompleted fire on every task (no matcher); TeammateIdle matches all agent types.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/supervisor_charter.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route_reminder.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/supervisor_gate.py\""
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/standup/control/team_task_created_hook.py\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/standup/control/team_task_completed_hook.py\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/standup/control/team_teammate_idle_hook.py\""
          }
        ]
      }
    ]
  }
}
